# syntax=docker/dockerfile:1

# Stage 1: Build and Train the Model
FROM python:3.10-slim AS model_training

WORKDIR /app

# install packages before copying code, so code changes don't redo the install
# the cache mount keeps downloaded packages between builds and stages
COPY requirements-train.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements-train.txt

COPY src/model_training.py /app/
RUN python model_training.py


# Stage 2: Serve Predictions
FROM python:3.10-slim AS serving

WORKDIR /app

COPY requirements-serve.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements-serve.txt

COPY --from=model_training /app/my_model.keras /app/
COPY --from=model_training /app/scaler.pkl /app/
COPY src/main.py /app/
COPY src/templates /app/templates
COPY src/statics /app/statics

# the app reads PORT, so the port it listens on and EXPOSE always match
ENV PORT=8000
EXPOSE 8000

CMD ["python", "main.py"]